.player-stats {
    position: absolute;
    right: 30px;
    bottom: 30px;
    width: 250px;
}

.stat-text {
    font-size: 30px;
    -unity-text-align: middle-right;
    margin-bottom: 4px;
    background-color: rgba(0, 0, 0, 0.176);
    color: rgb(255, 185, 0);
}

.bar {
    width: 250px;
    height: 20px;
    background-color: rgba(0, 0, 0, 0.6);
    margin-bottom: 10px;
}

.bar-fill {
    height: 100%;
    width: 100%;
}

.health-bar {
    background-color: rgb(41, 180, 40);
}

.rage-bar {
    background-color: rgb(180, 120, 40);
}

.spell-ui {
    position: absolute;
    left: 50%;
    bottom: 30px;
    translate: -50% 0;
}

.spell-icon-container {
    width: 80px;
    height: 80px;
    position: relative;
}

.spell-icon {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgb(80, 80, 100);
}

.spell-cooldown-overlay {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.7);
}

.spell-cooldown-text {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    -unity-text-align: middle-center;
    font-size: 24px;
    color: rgb(255, 169, 0);
}

.qte-keys {
    flex-direction: row;
    justify-content: center;
}

.qte-key-container {
    width: 200px;
    height: 200px;
    margin-left: 8px;
    margin-right: 8px;
    position: relative;
    background-color: rgba(20, 20, 20, 0.8);
}

.qte-key {
    width: 100%;
    height: 100%;
    -unity-text-align: middle-center;
    font-size: 150px;
    color: rgb(255, 181, 0);
}

.qte-timer {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(255, 255, 255, 0.25);
}

.level-up-container {
    position: absolute;

    left: 10%;
    right: 10%;
    top: 20%;
    bottom: 20%;

    align-items: center;
    justify-content: center;

    background-color: rgba(0, 0, 0, 0.85);
    border-radius: 20px;

    padding-left: 40px;
    padding-right: 40px;
    padding-top: 30px;
    padding-bottom: 30px;
}

.level-up-title {
    font-size: 42px;
    -unity-font-style: bold;

    color: white;

    margin-bottom: 10px;
}

.level-up-subtitle {
    font-size: 20px;

    color: rgb(190, 190, 190);

    margin-bottom: 30px;
}

.bonus-container {
    width: 100%;

    flex-direction: row;

    align-items: stretch;
    justify-content: center;
}

.bonus-button {
    flex-grow: 1;

    min-width: 0;

    min-height: 220px;

    background-color: rgba(40, 40, 40, 1);

    border-width: 2px;
    border-color: rgba(100, 100, 100, 1);

    border-radius: 15px;

    padding-left: 20px;
    padding-right: 20px;
    padding-top: 20px;
    padding-bottom: 20px;
}

.bonus-button:hover {
    background-color: rgba(65, 65, 65, 1);

    border-color: rgba(255, 255, 255, 1);
}

.bonus-button:active {
    background-color: rgba(90, 90, 90, 1);
}

.bonus-content {
    flex-grow: 1;

    align-items: center;
    justify-content: center;
}

.bonus-rarity {
    font-size: 18px;

    -unity-font-style: bold;
    -unity-text-align: middle-center;

    color: rgb(190, 190, 190);

    margin-bottom: 10px;
}

.bonus-name {
    font-size: 28px;

    -unity-font-style: bold;

    color: white;

    -unity-text-align: middle-center;

    margin-bottom: 20px;
}

.bonus-description {
    font-size: 18px;

    color: rgb(200, 200, 200);

    -unity-text-align: middle-center;
}

.experience-bar-background {
    position: absolute;

    left: 0;
    right: 0;
    bottom: 0;

    height: 12px;

    background-color: rgba(20, 20, 20, 0.8);
}

.experience-bar {
    width: 0%;

    height: 100%;

    background-color: rgb(40, 140, 255);
}
