.player-stats {
    position: absolute;
    right: 30px;
    bottom: 30px;
    width: 250px;
}

.stat-text {
    font-size: 30px;
    -unity-text-align: middle-right;
    margin-bottom: 4px;
    background-color: rgba(0, 0, 0, 0.176);
    color: rgb(255, 185, 0);
}

.bar {
    width: 250px;
    height: 20px;
    background-color: rgba(0, 0, 0, 0.6);
    margin-bottom: 10px;
}

.bar-fill {
    height: 100%;
    width: 100%;
}

.health-bar {
    background-color: rgb(41, 180, 40);
}

.rage-bar {
    background-color: rgb(180, 120, 40);
}

.spell-ui {
    position: absolute;
    left: 50%;
    bottom: 30px;
    translate: -50% 0;
}

.spell-icon-container {
    width: 80px;
    height: 80px;
    position: relative;
}

.spell-icon {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgb(80, 80, 100);
}

.spell-cooldown-overlay {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.7);
}

.spell-cooldown-text {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    -unity-text-align: middle-center;
    font-size: 24px;
    color: rgb(255, 169, 0);
}

.spell-charges-text {
    font-size: 14px;
    -unity-font-style: bold;
    color: white;
    -unity-text-align: middle-center;
}

.qte-keys {
    flex-direction: row;
    justify-content: center;
}

.qte-key-container {
    width: 200px;
    height: 200px;
    margin-left: 8px;
    margin-right: 8px;
    position: relative;
    background-color: rgba(20, 20, 20, 0.8);
}

.qte-key {
    width: 100%;
    height: 100%;
    -unity-text-align: middle-center;
    font-size: 150px;
    color: rgb(255, 181, 0);
}

.qte-timer {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(255, 255, 255, 0.25);
}

.experience-bar-background {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 12px;
    background-color: rgba(20, 20, 20, 0.8);
}

.experience-bar {
    width: 0%;
    height: 100%;
    background-color: rgb(40, 140, 255);
}

/* Fenêtre principale */
.augment-shop {
    position: absolute;
    left: 5%;
    right: 5%;
    top: 6%;
    bottom: 6%;

    padding: 24px;

    background-color: rgba(15, 17, 24, 0.97);

    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;

    border-top-color: rgb(174, 130, 55);
    border-bottom-color: rgb(174, 130, 55);
    border-left-color: rgb(174, 130, 55);
    border-right-color: rgb(174, 130, 55);
}

/* Ligne supérieure */
.shop-header {
    height: 58px;
    flex-shrink: 0;

    flex-direction: row;
    justify-content: space-between;
    align-items: center;

    margin-bottom: 20px;
}

/* Bouton Reroll */
.reroll-button {
    width: 170px;
    height: 48px;

    background-color: rgb(66, 51, 32);

    color: rgb(255, 210, 115);
    font-size: 20px;
    -unity-font-style: bold;

    border-top-color: rgb(190, 145, 65);
    border-bottom-color: rgb(190, 145, 65);
    border-left-color: rgb(190, 145, 65);
    border-right-color: rgb(190, 145, 65);
}

/* Compteur de points */
.skill-points-label {
    color: rgb(255, 210, 115);
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
}

/* Ligne des trois cartes */
.augment-cards {
    flex-grow: 1;
    min-height: 0;

    flex-direction: row;
    align-items: stretch;
    justify-content: space-between;
}

/* Cartes */
.augment-card {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;

    margin-left: 10px;
    margin-right: 10px;
    padding: 20px;

    background-color: rgb(29, 32, 43);

    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;

    border-top-color: rgb(95, 83, 60);
    border-bottom-color: rgb(95, 83, 60);
    border-left-color: rgb(95, 83, 60);
    border-right-color: rgb(95, 83, 60);
}

/* Rareté */
.augment-rarity {
    color: rgb(255, 194, 75);
    font-size: 17px;
    -unity-font-style: bold;

    margin-bottom: 22px;
}

/* Nom */
.augment-name {
    color: rgb(245, 245, 250);
    font-size: 25px;
    -unity-font-style: bold;

    white-space: normal;
    margin-bottom: 18px;
}

/* Description */
.augment-description {
    color: rgb(195, 199, 211);
    font-size: 18px;

    white-space: normal;
}

/* Instruction en bas */
.shop-instructions {
    height: 35px;
    flex-shrink: 0;

    margin-top: 16px;

    color: rgb(180, 183, 194);
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
